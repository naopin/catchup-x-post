{
  "permissions": {
    "allow": [
      "Write(*)",                                                           
      "Edit(*)",                                           
      "Bash(*)"                                                             
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker network rm:*)",
      "Bash(docker compose down:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
